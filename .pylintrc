[MASTER]
ignore=CVS,.git,__pycache__,build,dist,.venv,venv
persistent=yes
load-plugins=
py-version=3.8
extension-pkg-allow-list=numpy,torch

[MESSAGES CONTROL]
# Only disable messages that conflict with other tools or are redundant
disable=C0103,  # invalid-name
        R0903,  # too-few-public-methods
        # C0209,  # consider-using-f-string
        # W1514,  # unspecified-encoding
        # C0302,  # too-many-lines
        # R0801,  # duplicate-code
        # C0415,  # import-outside-toplevel
        # R0914,  # too-many-locals
        # R0913,  # too-many-arguments
        # R0912,  # too-many-branches
        # R0915,  # too-many-statements
        # W0511,  # fixme
        # W0212,  # protected-access
        # W0221,  # arguments-differ
        # W0613,  # unused-argument
        # W0102,  # dangerous-default-value
        # W0201,  # attribute-defined-outside-init
        # W0223,  # abstract-method
        W1203,
        E1101,  # no-member (often false positives with dynamic attributes)
        C0111,  # missing-docstring (redundant with flake8-docstrings)

[FORMAT]
max-line-length=79
indent-string='    '
indent-after-paren=4
expected-line-ending-format=LF

[BASIC]
good-names=i,j,k,ex,Run,_,fp,id
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$
variable-rgx=[a-z_][a-z0-9_]{2,30}$
function-rgx=[a-z_][a-z0-9_]{2,30}$
method-rgx=[a-z_][a-z0-9_]{2,30}$
attr-rgx=[a-z_][a-z0-9_]{2,30}$
argument-rgx=[a-z_][a-z0-9_]{2,30}$
class-rgx=[A-Z_][a-zA-Z0-9]+$
module-rgx=(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$

[SIMILARITIES]
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[TYPECHECK]
ignored-classes=numpy.ndarray,torch.Tensor
generated-members=numpy.*,torch.*
ignored-modules=numpy,torch,tensorflow,matplotlib,pandas,scipy

[MISCELLANEOUS]
notes=FIXME,XXX,TODO

[VARIABLES]
init-import=no
dummy-variables-rgx=_$|dummy
additional-builtins=

[IMPORTS]
allow-wildcard-with-all=no
analyse-fallback-blocks=no

[DESIGN]
max-args=5
max-locals=15
max-returns=6
max-branches=12
max-statements=50
max-parents=7
max-attributes=7
min-public-methods=1
max-public-methods=20

[CLASSES]
ignore-mixin-members=yes
defining-attr-methods=__init__,__new__,setUp
valid-classmethod-first-arg=cls
valid-metaclass-classmethod-first-arg=mcs
exclude-protected=_asdict,_fields,_replace,_source,_make

[EXCEPTIONS]
overgeneral-exceptions=Exception